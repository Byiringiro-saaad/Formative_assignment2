rules_version = '2';

// Access control for the Campus Incidents app.
//   users/{uid}       profile; role is "student" or "staff"
//   incidents/{id}    incident reports with an embedded status history
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Only ALU accounts: students and staff. Must match AppConfig in the app.
    function aluEmail() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower().matches('.*@(alustudent|alueducation)[.]com');
    }

    // A signed-in ALU account whose email address has been verified.
    function verified() {
      return aluEmail() && request.auth.token.email_verified == true;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStaff() {
      return verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == 'staff';
    }

    function validText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function validCategory(c) {
      return c in ['facilities', 'water', 'electricity', 'safety', 'sanitation', 'furniture'];
    }

    function validStatus(s) {
      return s in ['submitted', 'inProgress', 'resolved'];
    }

    function statusRank(s) {
      return s == 'submitted' ? 0 : (s == 'inProgress' ? 1 : 2);
    }

    // ---------- users ----------
    match /users/{uid} {
      // Your own profile, or any profile for staff.
      allow read: if isSelf(uid) || isStaff();

      // Everyone signs up as a student, with an ALU email. The profile is
      // written at sign-up, before the email is verified. Staff is granted
      // by an admin script.
      allow create: if isSelf(uid)
        && aluEmail()
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'department', 'campus', 'createdAt'])
        && request.resource.data.role == 'student'
        && validText(request.resource.data.name, 2, 60)
        && request.resource.data.email == request.auth.token.email;

      // Profile edits may not touch role, email or createdAt.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'department', 'campus'])
        && validText(request.resource.data.name, 2, 60);

      allow delete: if false;
    }

    // ---------- incidents ----------
    function photoBase() {
      return 'https://wkjdfzafkuwigelkxiir.supabase.co/storage/v1/object/public/incident-photos/';
    }

    // A history entry written by the current user under [name], dated around now. Array
    // entries can't use server timestamps, so allow some clock drift.
    function validChange(entry, status, name) {
      return entry is map
        && entry.keys().hasOnly(['status', 'changedAt', 'changedBy', 'changedByName', 'note'])
        && entry.status == status
        && entry.changedBy == request.auth.uid
        && entry.changedByName == name
        && entry.changedAt is timestamp
        && entry.changedAt > request.time - duration.value(1, 'h')
        && entry.changedAt < request.time + duration.value(1, 'h')
        && entry.note is string
        && entry.note.size() <= 300;
    }

    // No photo, or one in the reporter's own folder for this incident.
    function validPhoto(data, incidentId) {
      return (data.photoPath == null && data.photoUrl == null)
        || (data.photoPath is string
            && data.photoPath.matches(request.auth.uid + '/' + incidentId + '/[A-Za-z0-9-]+[.][a-z]+')
            && data.photoUrl == photoBase() + data.photoPath);
    }

    // The name a new report is filed under: the reporter's real name, or
    // "Anonymous" so other students can't see who filed it.
    function reporterLabel() {
      return request.resource.data.get('anonymous', false) == true
        ? 'Anonymous'
        : profile().name;
    }

    match /incidents/{incidentId} {
      // Any verified ALU user can browse reports.
      allow read: if verified();

      // A new report must belong to its author, carry the author's real
      // name (or "Anonymous"), start as "submitted" and use server time.
      allow create: if verified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.resource.data.keys().hasOnly([
             'title', 'description', 'category', 'location', 'status',
             'reporterId', 'reporterName', 'createdAt', 'updatedAt',
             'photoUrl', 'photoPath', 'history', 'anonymous'])
        && request.resource.data.get('anonymous', false) is bool
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName == reporterLabel()
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validText(request.resource.data.title, 3, 80)
        && validText(request.resource.data.description, 10, 1000)
        && validText(request.resource.data.location, 2, 80)
        && validCategory(request.resource.data.category)
        && request.resource.data.history is list
        && request.resource.data.history.size() == 1
        && validChange(request.resource.data.history[0], 'submitted', reporterLabel())
        && validPhoto(request.resource.data, incidentId);

      // Only staff change status: forward only, earlier history untouched,
      // exactly one new entry describing this change.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'history'])
        && validStatus(request.resource.data.status)
        && statusRank(request.resource.data.status) > statusRank(resource.data.status)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.history.size() == resource.data.history.size() + 1
        && request.resource.data.history[0:resource.data.history.size()] == resource.data.history
        && validChange(request.resource.data.history[resource.data.history.size()],
                       request.resource.data.status, profile().name);

      // Reporters can withdraw their own report until work starts.
      allow delete: if verified()
        && resource.data.reporterId == request.auth.uid
        && resource.data.status == 'submitted';
    }
  }
}
